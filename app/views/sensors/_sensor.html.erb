<div id="<%= dom_id sensor %>">
  <div>
    <strong>Equipment:</strong>
    <%= sensor.equipment_id %>
  </div>

  <div>
    <strong>Name:</strong>
    <%= sensor.name %>
  </div>

  <div>
    <strong>Sensor type:</strong>
    <%= sensor.sensor_type %>
  </div>

  <div>
    <strong>Unit:</strong>
    <%= sensor.unit %>
  </div>

  <div>
    <strong>Warning threshold:</strong>
    <%= sensor.warning_threshold %>
  </div>

  <div>
    <strong>Critical threshold:</strong>
    <%= sensor.critical_threshold %>
  </div>

</div>
